APP_NAME="SABIRA POSKESTREN Health"
APP_VERSION=0.23.0
APP_ENV=local
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost
TRUSTED_PROXIES=
SEED_DEMO_DATA=false

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

DB_CONNECTION=mariadb
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=poskestren_sabira
DB_USERNAME=root
DB_PASSWORD=
DB_SOCKET=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_CONNECTION=
SESSION_TABLE=sessions
SESSION_STORE=
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_EXPIRE_ON_CLOSE=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids
DB_QUEUE_CONNECTION=
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90

CACHE_STORE=database
DB_CACHE_CONNECTION=
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_CONNECTION=
DB_CACHE_LOCK_TABLE=cache_locks
CACHE_PREFIX=poskestren_health_cache_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_CACHE_CONNECTION=cache
REDIS_QUEUE=default
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE_RETRY_AFTER=90

AUTH_PASSWORD_TIMEOUT=10800

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SABIRA Gate SSO — keep disabled/fake until staging values are approved.
GATE_SSO_ENABLED=false
GATE_SYNC_APPLY_ENABLED=false
GATE_WEBHOOK_ENABLED=false
GATE_CLIENT_DRIVER=fake
GATE_BASE_URL=https://gate.example.invalid
GATE_CLIENT_ID=
GATE_CLIENT_SECRET=
GATE_REDIRECT_URI="${APP_URL}/auth/gate/callback"
GATE_SCOPES="openid profile email phone offline_access poskestren_access"
GATE_APP_CODE=poskestren-health
GATE_HTTP_TIMEOUT=5
GATE_HTTP_RETRY_ATTEMPTS=2
GATE_HTTP_RETRY_BACKOFF_MS=200
GATE_ENTITLEMENT_TTL=300

# Break-glass requires a separately approved operating procedure.
BREAK_GLASS_ENABLED=false
BREAK_GLASS_USERNAME=
BREAK_GLASS_ALERT_EMAIL=

# Attendance/outbox — no external delivery unless explicitly enabled.
ATTENDANCE_INTEGRATION_ENABLED=false
ATTENDANCE_INTEGRATION_DRIVER=fake
ATTENDANCE_INTEGRATION_ENDPOINT_URL=https://attendance.example.invalid/api/v1/health-dispositions
ATTENDANCE_INTEGRATION_API_KEY=
ATTENDANCE_INTEGRATION_TIMEOUT=5
ATTENDANCE_INTEGRATION_MAX_RETRIES=5
ATTENDANCE_INTEGRATION_BACKOFF_SECONDS=60
INTEGRATION_OUTBOX_BATCH_SIZE=25
INTEGRATION_OUTBOX_MAX_ATTEMPTS=5

# Application-specific pharmacy thresholds.
PHARMACY_EXPIRY_WARNING_DAYS=30
# PHARMACY_LOW_STOCK_THRESHOLD=
